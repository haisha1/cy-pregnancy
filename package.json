{
  "name": "cy-pregnancy-app",
  "version": "0.1.0",
  "private": true,
  "description": "春雨孕算工具 · uni-app Vue 3 + TypeScript",
  "scripts": {
    "dev:h5": "node scripts/uni.mjs",
    "dev:mp-weixin": "node scripts/uni.mjs -p mp-weixin",
    "build:h5": "node scripts/uni.mjs build",
    "build:mp-weixin": "node scripts/uni.mjs build -p mp-weixin && node scripts/check-wxss.mjs",
    "check:wxss": "node scripts/check-wxss.mjs",
    "typecheck": "vue-tsc --noEmit",
    "format": "prettier --write pages components composables engine store api utils types styles tests scripts \"data/*.ts\" \"*.ts\" \"*.vue\" \"*.json\"",
    "format:check": "prettier --check pages components composables engine store api utils types styles tests scripts \"data/*.ts\" \"*.ts\" \"*.vue\" \"*.json\"",
    "test": "tsx --test engine/__tests__/*.test.ts tests/*.test.ts",
    "test:e2e": "playwright test",
    "check:design": "designmd lint DESIGN.md",
    "audit:dependencies": "node scripts/audit-dependencies.mjs"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5020420260813003",
    "@dcloudio/uni-app-plus": "3.0.0-5020420260813003",
    "@dcloudio/uni-components": "3.0.0-5020420260813003",
    "@dcloudio/uni-h5": "3.0.0-5020420260813003",
    "@dcloudio/uni-mp-weixin": "3.0.0-5020420260813003",
    "pinia": "2.1.7",
    "vue": "3.4.21",
    "vue-i18n": "9.14.5"
  },
  "devDependencies": {
    "jsonc-parser": "3.3.1",
    "postcss": "8.5.30",
    "postcss-selector-parser": "6.1.2",
    "@dcloudio/types": "3.4.31",
    "@dcloudio/uni-cli-shared": "3.0.0-5020420260813003",
    "@dcloudio/vite-plugin-uni": "3.0.0-5020420260813003",
    "@google/design.md": "^0.3.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "prettier": "^3.9.10",
    "sass": "1.77.8",
    "tsx": "^4.20.0",
    "typescript": "5.6.3",
    "vite": "5.2.8",
    "vue-tsc": "2.1.10"
  }
}
